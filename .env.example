# maitred secrets — EDIT THIS FILE after copy, do NOT commit.
# Deploy path: ~/maitred/.env on the server, chmod 600, owner dev.

# Which discovery model provider the daemon uses (watch tier needs no model):
#   anthropic  -> needs ANTHROPIC_API_KEY   (default)
#   doubleword -> needs DOUBLEWORD_API_KEY  (personal account)
MAITRED_MODEL_PROVIDER=doubleword

# Paste your personal Doubleword key here:
DOUBLEWORD_API_KEY=
# Or switch provider above and paste an Anthropic key instead:
# ANTHROPIC_API_KEY=
